{
  "name": "pnrd-site",
  "version": "1.0.0",
  "description": "Site web du Parti National du Renouveau pour le Développement (PNRD)",
  "private": true,
  "scripts": {
    "serve": "node tools/server.js",
    "build": "node tools/build.js",
    "lint": "node tools/lint-html.js",
    "check": "node tools/build.js --check && node tools/lint-html.js && npm run validate",
    "prepare": "git config core.hooksPath .githooks",
    "validate": "html-validate index.html pages 404.html",
    "db:migrate": "node db/migrate.js",
    "db:import": "node db/import-site.js",
    "server": "node server/index.js",
    "admin:create": "node db/create-admin.js",
    "test": "node --test server/smoke.test.js",
    "build:db": "node tools/build-db.js",
    "check:db": "node tools/build-db.js --compare"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "html-validate": "^8.29.0"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  }
}
